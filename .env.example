# Datos del bot
BOT_NAME=GokuBot-MD
BOT_CREATOR=AmilcarGit
BOT_OWNER=
# Número del bot (código de país, solo dígitos). Obligatorio en Railway para generar el código de vinculación.
BOT_NUMBER=
BOT_PREFIX=.

# Servicios API (rellena solo si utilizarás esos comandos)
MENU_VIDEO=https://files.catbox.moe/nc2k5n.mp4
MEDIA_API_URL=https://api-yosoyyo-api-ofc.onrender.com
MEDIA_API_KEY=
YUI_API_URL=https://yuiapi.vercel.app
YUI_API_KEY=

# Temporadas: auto detecta fechas; manual usa ACTIVE_SEASON.
SEASONS_ENABLED=true
SEASON_MODE=auto
ACTIVE_SEASON=navidad
SEASON_TIMEZONE=America/Lima

# Rutas de almacenamiento (en Railway apúntalas a un volumen, ej: /data/session y /data/datos)
SESSION_DIR=
DATA_DIR=
